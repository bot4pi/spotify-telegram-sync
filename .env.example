# ── Telegram ───────────────────────────────────────────────────────────────
# my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Файл сессии. Создаётся при `npm run login` и наружу не уходит.
TG_SESSION_PATH=./data/session.sqlite

# ── Spotify ────────────────────────────────────────────────────────────────
# Приложение: developer.spotify.com/dashboard
# Redirect URI в его настройках — ровно такой, петлевой IP, не localhost:
#   http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Получить один раз: npm run spotify:login
SPOTIFY_REFRESH_TOKEN=

# ── Поиск трека ────────────────────────────────────────────────────────────
# Инлайн-боты, у которых спрашиваем трек, если его нет в своих чатах.
# По порядку, через запятую. Пусто — путь выключен.
MUSIC_INLINE_BOTS=Shazambot
# Куда складывать полученное от инлайн-бота. Пусто — «Избранное».
# Отдельный приватный чат чище: не мешает заметкам и работает кэшем.
MUSIC_CACHE_CHAT=

# ── Опрос ──────────────────────────────────────────────────────────────────
# Раз во сколько миллисекунд спрашивать Spotify, что играет. Это же время
# реакции на перемотку. 3000 — около 20 запросов в минуту при лимите ~180.
POLL_MS=3000
